<Window x:Class="ShinyCounter.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hunt name"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_Drag">

  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderHoverBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="20"
          Width="320">
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="hunt name"
                 FontSize="12" Foreground="{DynamicResource MutedBrush}"
                 Margin="0,0,0,10"/>
      <TextBox x:Name="NameBox" Style="{StaticResource NumBox}"
               Tag="e.g. Rayquaza" MaxLength="40" Margin="0,0,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Btn}" Content="ok"
                Background="{DynamicResource AccentDimBrush}"
                BorderBrush="{DynamicResource AccentBorderBrush}"
                Foreground="{DynamicResource AccentBrush}"
                Tag="{DynamicResource AccentHoverBrush}"
                Margin="0,0,8,0" Click="Ok_Click"/>
        <Button Grid.Column="1" Style="{StaticResource Btn}" Content="cancel"
                Width="80" Click="Cancel_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>

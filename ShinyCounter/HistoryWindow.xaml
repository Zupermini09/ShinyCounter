<Window x:Class="ShinyCounter.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hunt history"
        Icon="favicon.ico"
        Width="480" Height="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">

  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush2}"
          BorderThickness="1"
          CornerRadius="16"
          Margin="14"
          Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <TextBlock Text="COMPLETED HUNTS"
                 FontSize="13" FontWeight="Medium"
                 Foreground="{DynamicResource MutedBrush}"
                 Margin="0,0,0,14"/>

      <TextBlock x:Name="EmptyText" Grid.Row="1"
                 Text="No shinies logged yet — hit “✨ found!” when you get one."
                 FontSize="12" Foreground="{DynamicResource MutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="Collapsed"/>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListPanel"/>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>

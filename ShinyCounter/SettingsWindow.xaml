<Window x:Class="ShinyCounter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="favicon.ico"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">

  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="860">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="14"
            Padding="26,22">
      <StackPanel>

        <!-- ── General ── -->
        <TextBlock Text="GENERAL" FontSize="12" FontWeight="Medium"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,10">
          <TextBlock Text="tick sound" FontSize="13"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <ToggleButton x:Name="SoundToggle" Style="{StaticResource PinToggle}"
                        Content="🔊 sound on" HorizontalAlignment="Right"
                        Checked="Sound_Changed" Unchecked="Sound_Changed"/>
        </Grid>

        <Grid Margin="0,0,0,10">
          <TextBlock Text="window size" FontSize="13"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton x:Name="Scale70" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="70%" Tag="0.7" Checked="ScalePill_Checked"/>
            <RadioButton x:Name="Scale85" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="85%" Tag="0.85" Checked="ScalePill_Checked"/>
            <RadioButton x:Name="Scale100" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="100%" Tag="1.0" Checked="ScalePill_Checked"/>
            <RadioButton x:Name="Scale115" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="115%" Tag="1.15" Margin="0" Checked="ScalePill_Checked"/>
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="theme" FontSize="13"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <ComboBox x:Name="ThemeSelect" Grid.Column="1" Style="{StaticResource DarkCombo}"
                    SelectionChanged="Theme_Changed"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}" Content="📁"
                  Height="32" Width="36" Padding="0" Margin="6,0,0,0"
                  ToolTip="Open the themes folder" Click="OpenThemes_Click"/>
          <Button Grid.Column="3" Style="{StaticResource Btn}" Content="⟳"
                  Height="32" Width="36" Padding="0" Margin="6,0,0,0"
                  ToolTip="Reload theme list" Click="RefreshThemes_Click"/>
        </Grid>
        <TextBlock Text="drop .json files into the themes folder to add community themes — the stock files show the format"
                   FontSize="11" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>

        <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,16"/>

        <!-- ── Hunt ── -->
        <TextBlock x:Name="HuntHeader" Text="HUNT — HUNT 1" FontSize="12" FontWeight="Medium"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,8">
          <TextBlock Text="count trigger" FontSize="13"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="CountBindLabel" Text="not bound" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <Button x:Name="CountBindBtn" Style="{StaticResource PillBtn}"
                    Content="rebind" Click="BindCount_Click"/>
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
          <TextBlock Text="undo trigger" FontSize="13"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="UndoBindLabel" Text="not bound" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <Button x:Name="UndoBindBtn" Style="{StaticResource PillBtn}"
                    Content="rebind" Click="BindUndo_Click"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="shiny odds (1 / N)" Style="{StaticResource RowLabel}"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <RadioButton x:Name="Odds8192" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="8192" Tag="8192" Checked="OddsPill_Checked"/>
            <RadioButton x:Name="Odds4096" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="4096" Tag="4096" Checked="OddsPill_Checked"/>
            <RadioButton x:Name="Odds1365" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="1365" Tag="1365.33" ToolTip="Shiny charm"
                         Checked="OddsPill_Checked"/>
            <RadioButton x:Name="Odds512" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="512" Tag="512" Checked="OddsPill_Checked"/>
          </StackPanel>
          <TextBox x:Name="OddsInput" Grid.Column="1" Style="{StaticResource NumBox}"
                   Tag="custom" Height="32" Margin="0,0,8,0" KeyDown="OddsInput_KeyDown"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}" Content="set"
                  Height="32" Width="56" Click="SetOddsCustom_Click"/>
        </Grid>

        <TextBlock Text="increment per press" Style="{StaticResource RowLabel}"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <RadioButton x:Name="Step1" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="1" Tag="1" Checked="StepPill_Checked"/>
            <RadioButton x:Name="Step2" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="2" Tag="2" Checked="StepPill_Checked"/>
            <RadioButton x:Name="Step3" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="3" Tag="3" Checked="StepPill_Checked"/>
            <RadioButton x:Name="Step4" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="4" Tag="4" Checked="StepPill_Checked"/>
          </StackPanel>
          <TextBox x:Name="StepInput" Grid.Column="1" Style="{StaticResource NumBox}"
                   Tag="custom" Height="32" Margin="0,0,8,0" KeyDown="StepInput_KeyDown"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}" Content="set"
                  Height="32" Width="56" Click="SetStepCustom_Click"/>
        </Grid>

        <TextBlock Text="set counter manually" Style="{StaticResource RowLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ManualInput" Style="{StaticResource NumBox}" Tag="e.g. 167"
                   Height="32" Margin="0,0,8,0" KeyDown="ManualInput_KeyDown"/>
          <Button Grid.Column="1" Style="{StaticResource Btn}" Content="set"
                  Height="32" Width="56" Click="SetManual_Click"/>
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,16"/>

        <!-- ── About ── -->
        <TextBlock Text="ABOUT" FontSize="12" FontWeight="Medium"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
        <TextBlock x:Name="VersionText" Text="Shiny Counter"
                   FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3"/>
        <TextBlock Text="free &amp; open source — made for shiny hunters"
                   FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource GhostBtn}" Content="GitHub"
                  Margin="0,0,6,0" Click="OpenGitHub_Click"/>
          <Button Style="{StaticResource GhostBtn}" Content="report a bug"
                  Margin="0,0,6,0" Click="OpenIssues_Click"/>
          <Button Style="{StaticResource GhostBtn}" Content="☕ buy me a coffee"
                  Click="OpenCoffee_Click"/>
        </StackPanel>

      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>

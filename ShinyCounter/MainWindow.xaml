<Window x:Class="ShinyCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiny Counter"
        Icon="favicon.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E10"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

  <Grid>

    <!-- ════════ Full card ════════ -->
    <Border x:Name="Card"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1"
            CornerRadius="20"
            Margin="18"
            Padding="34,26"
            Width="520">
      <Border.LayoutTransform>
        <ScaleTransform x:Name="CardScale"/>
      </Border.LayoutTransform>
      <StackPanel>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
          <TextBlock Text="SHINY COUNTER"
                     FontSize="13" FontWeight="Medium"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ToggleButton x:Name="SoundToggleBtn" Style="{StaticResource PinToggle}"
                          Content="🔊" ToolTip="Tick sound on each count"
                          Margin="0,0,6,0"
                          Checked="Sound_Changed" Unchecked="Sound_Changed"/>
            <ToggleButton x:Name="PinToggleBtn" Style="{StaticResource PinToggle}"
                          Content="📌" ToolTip="Keep window on top"
                          Margin="0,0,6,0"
                          Checked="Pin_Changed" Unchecked="Pin_Changed"/>
            <Button x:Name="MiniBtn" Style="{StaticResource GhostBtn}"
                    Content="mini" ToolTip="Shrink to a tiny overlay"
                    Margin="0,0,8,0" Click="Mini_Click"/>
            <Border x:Name="StatusPill"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="10,4"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="6" Height="6"
                         Fill="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="no controller"
                           FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Hunt selector -->
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="HuntSelect" Style="{StaticResource DarkCombo}"
                    Margin="0,0,8,0" SelectionChanged="HuntSelect_Changed"/>
          <Button Grid.Column="1" Style="{StaticResource Btn}" Content="＋"
                  Height="32" Width="32" Padding="0" ToolTip="New hunt"
                  Margin="0,0,6,0" Click="NewHunt_Click"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}" Content="✎"
                  Height="32" Width="32" Padding="0" ToolTip="Rename hunt"
                  Margin="0,0,6,0" Click="RenameHunt_Click"/>
          <Button Grid.Column="3" Style="{StaticResource Btn}" Content="✕"
                  Height="32" Width="32" Padding="0" ToolTip="Delete hunt"
                  Click="DeleteHunt_Click"/>
        </Grid>

        <!-- Counter -->
        <TextBlock Text="SOFT RESETS" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="CounterText" Text="0"
                   FontSize="80" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
          <TextBlock Text="count:" FontSize="11"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="BindBtn" Style="{StaticResource PillBtn}"
                  Content="rebind" Click="BindBtn_Click"/>
          <TextBlock Text="undo:" FontSize="11"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="14,0,6,0"/>
          <Button x:Name="UndoBindBtn" Style="{StaticResource PillBtn}"
                  Content="rebind" Click="UndoBindBtn_Click"/>
        </StackPanel>
        <TextBlock x:Name="BoundDisplay" Text="count: not bound · undo: not bound"
                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,18"
                   ToolTip="Triggers are global — they count even while your game window is focused"/>

        <!-- Stats -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource StatCard}" Grid.Column="0" Margin="0,0,5,0">
            <StackPanel>
              <TextBlock Text="your odds" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="OddsVal" Text="—" FontSize="15" FontWeight="Medium"
                         Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}" Grid.Column="1" Margin="5,0">
            <StackPanel>
              <TextBlock Text="50% at" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="ExpectedVal" Text="—" FontSize="15" FontWeight="Medium"
                         Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}" Grid.Column="2" Margin="5,0,0,0">
            <StackPanel>
              <TextBlock Text="chance hit" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="ProbVal" Text="0%" FontSize="15" FontWeight="Medium"
                         Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource StatCard}" Grid.Column="0" Margin="0,0,5,0">
            <StackPanel>
              <TextBlock Text="time hunted" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="TimeVal" Text="—" FontSize="15" FontWeight="Medium"
                         Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}" Grid.Column="1" Margin="5,0">
            <StackPanel>
              <TextBlock Text="pace" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="RateVal" Text="—" FontSize="15" FontWeight="Medium"
                         Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}" Grid.Column="2" Margin="5,0,0,0">
            <StackPanel>
              <TextBlock Text="50% eta" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="EtaVal" Text="—" FontSize="15" FontWeight="Medium"
                         Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Probability bar -->
        <Border x:Name="BarTrack" Height="3" CornerRadius="2"
                Background="{StaticResource HintBrush}">
          <Border x:Name="BarFill" Height="3" CornerRadius="2" Width="0"
                  Background="{StaticResource AccentBrush}"
                  HorizontalAlignment="Left"/>
        </Border>
        <Grid Margin="0,6,0,0">
          <TextBlock Text="0%" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="BarLabel" Text="0% probability" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="100%" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
        </Grid>

        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,18"/>

        <!-- Shiny odds -->
        <TextBlock Text="shiny odds (1 / N)" Style="{StaticResource RowLabel}"/>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <RadioButton x:Name="Odds8192" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="8192" Tag="8192" Checked="OddsPill_Checked"/>
            <RadioButton x:Name="Odds4096" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="4096" Tag="4096" Checked="OddsPill_Checked"/>
            <RadioButton x:Name="Odds1365" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="1365" Tag="1365.33" ToolTip="Shiny charm"
                         Checked="OddsPill_Checked"/>
            <RadioButton x:Name="Odds512" Style="{StaticResource PillRadio}" GroupName="odds"
                         Content="512" Tag="512" Checked="OddsPill_Checked"/>
          </StackPanel>
          <TextBox x:Name="OddsInput" Grid.Column="1" Style="{StaticResource NumBox}"
                   Tag="custom" Height="32" Margin="0,0,8,0" KeyDown="OddsInput_KeyDown"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}" Content="set"
                  Height="32" Width="60" Click="SetOddsCustom_Click"/>
        </Grid>

        <!-- Step -->
        <TextBlock Text="increment per press" Style="{StaticResource RowLabel}"/>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <RadioButton x:Name="Step1" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="1" Tag="1" Checked="StepPill_Checked"/>
            <RadioButton x:Name="Step2" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="2" Tag="2" Checked="StepPill_Checked"/>
            <RadioButton x:Name="Step3" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="3" Tag="3" Checked="StepPill_Checked"/>
            <RadioButton x:Name="Step4" Style="{StaticResource PillRadio}" GroupName="step"
                         Content="4" Tag="4" Checked="StepPill_Checked"/>
          </StackPanel>
          <TextBox x:Name="StepInput" Grid.Column="1" Style="{StaticResource NumBox}"
                   Tag="custom" Height="32" Margin="0,0,8,0" KeyDown="StepInput_KeyDown"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}" Content="set"
                  Height="32" Width="60" Click="SetStepCustom_Click"/>
        </Grid>

        <!-- Action buttons -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="IncrementBtn" Style="{StaticResource Btn}"
                  Background="{StaticResource AccentDimBrush}"
                  BorderBrush="{StaticResource AccentBorderBrush}"
                  Foreground="{StaticResource AccentBrush}"
                  Tag="{StaticResource AccentHoverBrush}"
                  Content="+ 1 manual" Margin="0,0,8,0"
                  Click="Increment_Click"/>
          <Button Grid.Column="1" Style="{StaticResource Btn}" Content="undo"
                  Width="80" Margin="0,0,8,0" Click="Undo_Click"
                  ToolTip="Subtract one increment"/>
          <Button Grid.Column="2" Style="{StaticResource Btn}"
                  Background="{StaticResource DangerDimBrush}"
                  BorderBrush="{StaticResource DangerBorderBrush}"
                  Foreground="{StaticResource DangerBrush}"
                  Tag="{StaticResource DangerHoverBrush}"
                  Content="reset" Width="80" Click="Reset_Click"/>
        </Grid>

        <!-- Found + history -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Btn}"
                  Background="{StaticResource SuccessDimBrush}"
                  BorderBrush="{StaticResource SuccessBorderBrush}"
                  Foreground="{StaticResource SuccessBrush}"
                  Tag="{StaticResource SuccessHoverBrush}"
                  Content="✨ found!" Margin="0,0,8,0"
                  ToolTip="Log this hunt to history and reset the counter"
                  Click="Found_Click"/>
          <Button Grid.Column="1" Style="{StaticResource Btn}" Content="history"
                  Width="90" Click="History_Click"/>
        </Grid>

        <!-- Manual set -->
        <TextBlock Text="set counter manually" Style="{StaticResource RowLabel}"/>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ManualInput" Style="{StaticResource NumBox}" Tag="e.g. 167"
                   Height="32" Margin="0,0,8,0" KeyDown="ManualInput_KeyDown"/>
          <Button Grid.Column="1" Style="{StaticResource Btn}" Content="set"
                  Height="32" Width="60" Click="SetManual_Click"/>
        </Grid>

        <!-- Window size -->
        <Grid>
          <TextBlock Text="window size" FontSize="12"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton x:Name="Scale70" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="70%" Tag="0.7" Checked="ScalePill_Checked"/>
            <RadioButton x:Name="Scale85" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="85%" Tag="0.85" Checked="ScalePill_Checked"/>
            <RadioButton x:Name="Scale100" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="100%" Tag="1.0" Checked="ScalePill_Checked"/>
            <RadioButton x:Name="Scale115" Style="{StaticResource PillRadio}" GroupName="scale"
                         Content="115%" Tag="1.15" Margin="0" Checked="ScalePill_Checked"/>
          </StackPanel>
        </Grid>

      </StackPanel>
    </Border>

    <!-- ════════ Mini overlay ════════ -->
    <Border x:Name="MiniPanel"
            Visibility="Collapsed"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,8,8,10"
            Cursor="SizeAll"
            MouseLeftButtonDown="Mini_Drag">
      <StackPanel>
        <Grid>
          <TextBlock x:Name="MiniName" Text="Hunt 1"
                     FontSize="10" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,30,0"
                     MaxWidth="120" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="MiniRestoreBtn" Style="{StaticResource GhostBtn}"
                  Content="⤢" Padding="7,1" ToolTip="Back to full window"
                  HorizontalAlignment="Right" Click="MiniRestore_Click"/>
        </Grid>
        <TextBlock x:Name="MiniCount" Text="0"
                   FontSize="30" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="MiniProb" Text="0% chance hit"
                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,8,0"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
